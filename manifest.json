{
  "manifest_version": 3,
  "name": "WCAG 2.2 Accessibility Compliance Auditor",
  "version": "1.0.0",
  "description": "Automated digital accessibility auditor evaluating web pages against the latest WCAG 2.2 AA standards with interactive :hover contrast, ARIA linter, and vector PDF exports.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WCAG 2.2 Compliance Auditor",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs",
    "sidePanel",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
